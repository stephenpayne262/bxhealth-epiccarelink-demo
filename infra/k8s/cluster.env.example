# Copy to infra/k8s/.env.k8s and fill in deployment-only OIDC credentials.
CLIENT_ID=replace-with-oidc-client-id
CLIENT_SECRET=replace-with-oidc-client-secret
TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
OIDC_DEBUG=false
REDIRECT_URI=https://bxhealth-epiccarelink-demo.ping-devops.com/auth/callback
POST_LOGOUT_REDIRECT_URI=https://bxhealth-epiccarelink-demo.ping-devops.com/
MYCHART_CLIENT_ID=replace-with-demo-mychart-oidc-client-id
MYCHART_CLIENT_SECRET=replace-with-demo-mychart-oidc-client-secret
MYCHART_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
MYCHART_REDIRECT_URI=https://bxhealth-epiccarelink-demo.ping-devops.com/mychart/auth/callback
MYCHART_POST_LOGOUT_REDIRECT_URI=https://bxhealth-epiccarelink-demo.ping-devops.com/
SCOPE=openid profile email

# Optional MyChart with PingOne and DaVinci (separate from the AIC demos).
# Set these before using /mychart-pingone. Use the issuer's actual discovery URL.
MYCHART_PINGONE_DISCOVERY_URL=
MYCHART_PINGONE_CLIENT_ID=
MYCHART_PINGONE_CLIENT_SECRET=
MYCHART_PINGONE_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
MYCHART_PINGONE_SCOPE=openid profile email
MYCHART_PINGONE_REDIRECT_URI=https://bxhealth-epiccarelink-demo.ping-devops.com/mychart-pingone/auth/callback
MYCHART_PINGONE_POST_LOGOUT_REDIRECT_URI=https://bxhealth-epiccarelink-demo.ping-devops.com/

# Optional: override discovery or endpoint configuration for this tenant.
# DISCOVERY_URL=https://your-tenant.example/.well-known/openid-configuration
# JWKS_URI=https://your-tenant.example/jwks
# AUTHORIZATION_ENDPOINT=https://your-tenant.example/authorize
# TOKEN_ENDPOINT=https://your-tenant.example/token
# USERINFO_ENDPOINT=https://your-tenant.example/userinfo
# ISSUER=https://your-tenant.example/issuer
# AIC_REGISTER_AUTH_INDEX_TYPE=service
# AIC_REGISTER_AUTH_INDEX_VALUE=your-registration-journey-name