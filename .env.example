PORT=3010
# Enable redacted OIDC stage/timing logs in Docker stdout; errors are always logged.
OIDC_DEBUG=false
CLIENT_ID=epiccarelink
CLIENT_SECRET=epicsecret
TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
REDIRECT_URI=http://localhost:3010/auth/callback
POST_LOGOUT_REDIRECT_URI=http://localhost:3010/
MYCHART_CLIENT_ID=demo-mychart
MYCHART_CLIENT_SECRET=demomychartsecret
MYCHART_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
MYCHART_REDIRECT_URI=http://localhost:3010/mychart/auth/callback
MYCHART_POST_LOGOUT_REDIRECT_URI=http://localhost:3010/
SCOPE=openid profile email
DISCOVERY_URL=https://openam-scp-1025.forgeblocks.com/am/oauth2/realms/root/realms/alpha/.well-known/openid-configuration
JWKS_URI=
END_SESSION_ENDPOINT=
POST_LOGOUT_REDIRECT_URI=http://localhost:3010/
AUTHORIZATION_ENDPOINT=https://openam-scp-1025.forgeblocks.com/am/oauth2/alpha/authorize
TOKEN_ENDPOINT=https://openam-scp-1025.forgeblocks.com/am/oauth2/alpha/access_token
USERINFO_ENDPOINT=https://openam-scp-1025.forgeblocks.com/am/oauth2/alpha/userinfo
ISSUER=https://openam-scp-1025.forgeblocks.com:443/am/oauth2/realms/root/realms/alpha
AIC_REGISTER_AUTH_INDEX_TYPE=
AIC_REGISTER_AUTH_INDEX_VALUE=

# ---------------------------------------------------------------------------
# MyChart with PingOne and DaVinci - /mychart-pingone
# Keep the existing AIC settings above unchanged. Add these values to your
# ignored .env file only; never commit real client secrets.
#
# Required: copy the Discovery / OpenID Configuration URL from the PingOne app.
# Standard PingOne issuer example (use your environment's regional/custom host):
# https://auth.pingone.com/<environment-id>/as/.well-known/openid-configuration
# Discovery supplies issuer, authorization/token/UserInfo/logout endpoints and
# JWKS URI. No separate endpoint values are needed when discovery is available.
# For a DaVinci-issued OIDC app, copy its actual discovery URL instead of
# assuming the PingOne /as/ URL; its issuer and client credentials may differ.
MYCHART_PINGONE_DISCOVERY_URL=
#
# Required: OAuth/OIDC application Client ID and Client Secret (not a worker
# application, environment API credential, or DaVinci SDK API key).
# Configure a confidential web app with Authorization Code grant, response type
# code, and PKCE S256. Match the application's Token Endpoint Auth Method:
# client_secret_basic (HTTP Basic) or client_secret_post (form body).
MYCHART_PINGONE_CLIENT_ID=
MYCHART_PINGONE_CLIENT_SECRET=
MYCHART_PINGONE_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
#
# Request only scopes enabled for the application; openid is required for OIDC.
MYCHART_PINGONE_SCOPE=openid profile email
#
# URLs separate from the existing /mychart AIC demo.
# Register these exact values on the PingOne app.
# For deployment, replace localhost with the demo's HTTPS origin.
MYCHART_PINGONE_REDIRECT_URI=http://localhost:3010/mychart-pingone/auth/callback
MYCHART_PINGONE_POST_LOGOUT_REDIRECT_URI=http://localhost:3010/
#
# DaVinci orchestration: configure the app's sign-on policy to use the intended
# DaVinci flow. The authorization request sends flow=login or flow=register;
# configure your DaVinci journey to read this parameter and branch accordingly.
# This parameter does not select a PingOne sign-on policy automatically.
# This hosted OIDC setup does not require embedding a DaVinci SDK API key here.
