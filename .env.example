# Copy to .env for local Docker. Replace placeholder credentials before use.
PORT=3010
OIDC_DEBUG=false

# EpicCare Link - PingOne AIC
CLIENT_ID=epiccarelink
CLIENT_SECRET=replace-with-aic-client-secret
TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
REDIRECT_URI=http://localhost:3010/epiccarelink/auth/callback
POST_LOGOUT_REDIRECT_URI=http://localhost:3010/
SCOPE=openid profile email
DISCOVERY_URL=https://openam-scp-1025.forgeblocks.com/am/oauth2/realms/root/realms/alpha/.well-known/openid-configuration

# Shared AIC fallback endpoints and optional registration/recovery journeys
AUTHORIZATION_ENDPOINT=https://openam-scp-1025.forgeblocks.com/am/oauth2/alpha/authorize
TOKEN_ENDPOINT=https://openam-scp-1025.forgeblocks.com/am/oauth2/alpha/access_token
USERINFO_ENDPOINT=https://openam-scp-1025.forgeblocks.com/am/oauth2/alpha/userinfo
ISSUER=https://openam-scp-1025.forgeblocks.com:443/am/oauth2/realms/root/realms/alpha
AIC_REGISTER_AUTH_INDEX_TYPE=
AIC_REGISTER_AUTH_INDEX_VALUE=
AIC_RECOVER_AUTH_INDEX_TYPE=
AIC_RECOVER_AUTH_INDEX_VALUE=

# MyChart - PingOne AIC (shares AIC discovery, scope, and journey settings)
MYCHART_CLIENT_ID=replace-with-mychart-aic-client-id
MYCHART_CLIENT_SECRET=replace-with-mychart-aic-client-secret
MYCHART_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
MYCHART_REDIRECT_URI=http://localhost:3010/mychart/auth/callback
MYCHART_POST_LOGOUT_REDIRECT_URI=http://localhost:3010/

# MyChart - PingOne and DaVinci
MYCHART_PINGONE_DISCOVERY_URL=
MYCHART_PINGONE_CLIENT_ID=
MYCHART_PINGONE_CLIENT_SECRET=
MYCHART_PINGONE_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
MYCHART_PINGONE_SCOPE=openid profile email
MYCHART_PINGONE_REDIRECT_URI=http://localhost:3010/mychart-pingone/auth/callback
MYCHART_PINGONE_POST_LOGOUT_REDIRECT_URI=http://localhost:3010/

# EpicCare Link - PingOne and DaVinci
EPICCARE_PINGONE_DISCOVERY_URL=
EPICCARE_PINGONE_CLIENT_ID=
EPICCARE_PINGONE_CLIENT_SECRET=
EPICCARE_PINGONE_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
EPICCARE_PINGONE_SCOPE=openid profile email
EPICCARE_PINGONE_REDIRECT_URI=http://localhost:3010/epiccare-pingone/auth/callback
EPICCARE_PINGONE_POST_LOGOUT_REDIRECT_URI=http://localhost:3010/

# Match each client's auth method and registered URLs at the provider.
# DaVinci must handle flow=login, flow=register, and flow=recover.
# All flows share their client's settings; local password screens are demo-only.
